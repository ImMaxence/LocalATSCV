{
  "name": "localatscv",
  "version": "0.3.0",
  "description": "Générateur de CV optimisé ATS, 100 % local : aucune donnée ne quitte le navigateur.",
  "license": "MIT",
  "author": "Maxence Bonnici",
  "homepage": "https://localatscv.mbonnici.fr",
  "repository": {
    "type": "git",
    "url": "https://github.com/ImMaxence/LocalATSCV.git"
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "docker:local": "docker compose -f docker-compose.yml -f docker-compose.local.yml up --build -d",
    "docker:down": "docker compose -f docker-compose.yml -f docker-compose.local.yml down",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@angular/cdk": "^22.2.5",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/service-worker": "^22.2.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@jsverse/transloco": "^8.4.0",
    "dexie": "^4.4.7",
    "fflate": "^0.8.3",
    "pdfjs-dist": "^6.4.299",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "jsdom": "^30.0.0",
    "playwright-core": "^1.64.1",
    "postcss": "^8.5.32",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
